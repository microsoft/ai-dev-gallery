<Project>
  <!-- Keep one compatible copy of each native runtime in the packaged app. -->
  <Target Name="SelectFoundryNativeRuntimeLibs" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <!-- Foundry Local 2.x requires its GenAI build; keep AIDG's CUDA companion library below. -->
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').Equals('Microsoft.ML.OnnxRuntimeGenAI.WinML', StringComparison.OrdinalIgnoreCase))
                                       And $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^onnxruntime-genai\.(dll|lib)$', RegexOptions.IgnoreCase))" />
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.FullPath)').IndexOf('microsoft.ml.onnxruntimegenai.winml', StringComparison.OrdinalIgnoreCase)) &gt;= 0
                       And $([System.String]::Copy('%(Filename)%(Extension)').Equals('onnxruntime-genai.dll', StringComparison.OrdinalIgnoreCase))" />

      <!-- AIDG already ships a newer Windows ML runtime through WindowsAppSDK.ML. -->
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').Equals('Microsoft.AI.Foundry.Local.Runtime', StringComparison.OrdinalIgnoreCase))
                                       And $([System.String]::Copy('%(Filename)%(Extension)').Equals('Microsoft.Windows.AI.MachineLearning.dll', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>

    <Message Importance="High" Text="Selected one compatible copy of the Foundry Local, ORT GenAI, and Windows ML native runtimes." />
  </Target>

  <!-- Remove CUDA EP on Windows x64. onnxruntime-genai-cuda.dll is required for TRT RTX models. -->
  <Target Name="ExcludeCudaLibs" Condition="'$(RuntimeIdentifier)'=='win-x64' Or '$(Platform)'=='x64'" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <!-- match onnxruntime_providers_cuda (we're matching %(Filename) which excludes the extension) -->
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', 
                                      'onnxruntime_providers_cuda', RegexOptions.IgnoreCase))" />
    </ItemGroup>
    <Message Importance="Normal" Text="Excluded onnxruntime CUDA libraries from package (except onnxruntime-genai-cuda)." />
  </Target>

  <!-- Remove QNN EP and IHV libraries on Windows ARM64 -->
  <Target Name="ExcludeQnnLibs" Condition="'$(RuntimeIdentifier)'=='win-arm64' Or '$(Platform)'=='ARM64'" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', 
                                      '^QNN.*\.dll', RegexOptions.IgnoreCase))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', 
                                      '^libQNNhtp.*', RegexOptions.IgnoreCase))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(FileName)%(Extension)' == 'onnxruntime_providers_qnn.dll'" />
    </ItemGroup>
    <Message Importance="Normal" Text="Excluded onnxruntime QNN libraries from package." />
  </Target>
</Project>
